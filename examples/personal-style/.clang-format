# Personal style using the brace-policy extension from issue #2.
BasedOnStyle: LLVM
Language: Cpp
UseTab: Always
TabWidth: 4
IndentWidth: 4
AccessModifierOffset: -4
IndentAccessModifiers: false
ContinuationIndentWidth: 4
BreakConstructorInitializers: AfterColon
PackConstructorInitializers: Never
ConstructorInitializerIndentWidth: 4
Cpp11BracedListStyle: Block
PointerAlignment: Left
ReferenceAlignment: Left
NamespaceIndentation: All
BreakTemplateDeclarations: Yes
BreakAfterReturnType: AllDefinitions
SpaceAfterTemplateKeyword: false
MaxEmptyLinesToKeep: 2
AlignTrailingComments:
  Kind: Leave
ColumnLimit: 120
FunctionDeclarationSeparatorColumn: 80
PackArguments:
  BinPack: OnePerLine
AllowAllArgumentsOnNextLine: false
PackParameters:
  BinPack: OnePerLine
AllowAllParametersOfDeclarationOnNextLine: false
AlignAfterOpenBracket: true
BreakBeforeBraces: Custom
BraceWrapping:
  AfterCaseLabel: true
  AfterClass: true
  AfterControlStatement: Always
  AfterEnum: false
  AfterExportBlock: true
  AfterExternBlock: true
  AfterFunction: true
  AfterNamespace: true
  AfterObjCDeclaration: true
  AfterRequiresExpression: true
  AfterStruct: true
  AfterUnion: true
  BeforeCatch: true
  BeforeElse: true
  BeforeLambdaBody: true
IndentCaseLabels: false
IndentCaseBlocks: true
AllowShortBlocksOnASingleLine: Empty
AllowShortEnumsOnASingleLine: true
AllowShortFunctionsOnASingleLine: None
AllowShortLambdasOnASingleLine: All
LambdaBodyIndentation: OuterScope
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
SpaceBeforeParens: ControlStatements
SpacesInParens: Custom
SpacesInParensOptions:
  InConditionalStatements: true
  ExceptForLoops: true
  ExceptSwitchStatements: true
  InNamedCalls: [ASSERT, VERIFY]
  InCStyleCasts: false
  InEmptyParentheses: false
  Other: false
SpaceAfterLogicalNot: true
ControlStatementBraces:
  Mode: SingleStatement
  IfChain: Consistent
  WrappedCondition: Require
RemoveBracesLLVM: false
InsertBraces: false
